# RequireX AI - LLM Model Evaluation Lab Environment Configuration
# Copy this file to .env.local to configure live API keys.
# When keys are left blank or omitted, RequireX operates in deterministic "Demo / Mock Evaluation Mode".

# OpenAI API Key (GPT-4o, GPT-4o-mini)
VITE_OPENAI_API_KEY=

# Google Gemini API Key (Gemini 1.5 Pro, Gemini 1.5 Flash)
VITE_GEMINI_API_KEY=

# Anthropic Claude API Key (Claude 3.5 Sonnet, Claude 3.5 Haiku)
VITE_ANTHROPIC_API_KEY=

# Custom / Local Ollama / OpenRouter Endpoint (Optional)
VITE_CUSTOM_LLM_ENDPOINT=http://localhost:11434/v1
VITE_CUSTOM_LLM_API_KEY=
